<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <FactionColonies.FCEventDef>
    <defName>blacksmithInspiration_0</defName>
    <label>Blacksmith Inspiration</label>
    <desc>A blacksmith in a nearby settlement has received a great inspiration and is seeking patrons for what he claims will be a work of unparalleled quality! He plans to give it to his patron as a token of his loyalty.</desc>
    <category>EC_Economy</category>
    <timeTillTrigger>0</timeTillTrigger>
    <activateAtStart>true</activateAtStart>
    <isRandomEvent>true</isRandomEvent>
    <weight>10</weight>
    <requiredResource>RTD_Weapons</requiredResource>
    <incompatibleEvents>
      <li>blacksmithInspiration_1-1</li>
      <li>blacksmithInspiration_1-2s</li>
      <li>blacksmithInspiration_1-2f</li>
      <li>blacksmithInspiration_1-3</li>
    </incompatibleEvents>
    <options>
      <li>blacksmithInspiration_0_1</li>
      <li>blacksmithInspiration_0_2</li>
      <li>blacksmithInspiration_0_3</li>
      <li>blacksmithInspiration_0_4</li>
    </options>
  </FactionColonies.FCEventDef>

  <FactionColonies.FCOptionDef>
    <defName>blacksmithInspiration_0_1</defName>
    <label>I cannot spare the funds for such an endeavor.</label>
    <parentEvent>blacksmithInspiration_0</parentEvent>
    <baseChanceOfSuccess>100</baseChanceOfSuccess>
  </FactionColonies.FCOptionDef>

  <FactionColonies.FCOptionDef>
    <defName>blacksmithInspiration_0_2</defName>
    <label>A modest commission — 500 silver should suffice.</label>
    <parentEvent>blacksmithInspiration_0</parentEvent>
    <baseChanceOfSuccess>100</baseChanceOfSuccess>
    <silverCost>500</silverCost>
    <successEvent>blacksmithInspiration_1-1</successEvent>
  </FactionColonies.FCOptionDef>

  <FactionColonies.FCOptionDef>
    <defName>blacksmithInspiration_0_3</defName>
    <label>Fund the masterwork! Spare no expense.</label>
    <parentEvent>blacksmithInspiration_0</parentEvent>
    <baseChanceOfSuccess>60</baseChanceOfSuccess>
    <silverCost>1500</silverCost>
    <successEvent>blacksmithInspiration_1-2s</successEvent>
    <failEvent>blacksmithInspiration_1-2f</failEvent>
  </FactionColonies.FCOptionDef>

  <FactionColonies.FCOptionDef>
    <defName>blacksmithInspiration_0_4</defName>
    <label>I'll provide workshop materials from our settlement stores.</label>
    <parentEvent>blacksmithInspiration_0</parentEvent>
    <baseChanceOfSuccess>100</baseChanceOfSuccess>
    <successEvent>blacksmithInspiration_1-3</successEvent>
  </FactionColonies.FCOptionDef>

  <FactionColonies.FCEventDef>
    <defName>blacksmithInspiration_1-1</defName>
    <label>Blacksmith Inspiration</label>
    <desc>The blacksmith is working on your commission...</desc>
    <category>EC_Economy</category>
    <timeTillTrigger>180000</timeTillTrigger>
    <timeTillTriggerMax>240000</timeTillTriggerMax>
    <rangeSettlementsAffected>1~1</rangeSettlementsAffected>
    <incompatibleEvents>
      <li>blacksmithInspiration_0</li>
    </incompatibleEvents>
    <randomThingValue>700</randomThingValue>
    <randomThingRewardDef>RERD_Weapons</randomThingRewardDef>
  </FactionColonies.FCEventDef>

  <FactionColonies.FCEventDef>
    <defName>blacksmithInspiration_1-2s</defName>
    <label>Blacksmith Inspiration (Masterwork)</label>
    <desc>The blacksmith's inspiration has produced a true masterwork! The result exceeds all expectations.</desc>
    <category>EC_Economy</category>
    <timeTillTrigger>180000</timeTillTrigger>
    <timeTillTriggerMax>240000</timeTillTriggerMax>
    <rangeSettlementsAffected>1~1</rangeSettlementsAffected>
    <incompatibleEvents>
      <li>blacksmithInspiration_0</li>
    </incompatibleEvents>
    <randomThingValue>2800</randomThingValue>
    <randomThingRewardDef>RERD_Weapons</randomThingRewardDef>
  </FactionColonies.FCEventDef>

  <FactionColonies.FCEventDef>
    <defName>blacksmithInspiration_1-2f</defName>
    <label>Blacksmith Inspiration (Disappointing)</label>
    <desc>The blacksmith's ambition outpaced his skill. The result is serviceable, but far from the masterwork promised.</desc>
    <category>EC_Economy</category>
    <timeTillTrigger>180000</timeTillTrigger>
    <timeTillTriggerMax>240000</timeTillTriggerMax>
    <rangeSettlementsAffected>1~1</rangeSettlementsAffected>
    <incompatibleEvents>
      <li>blacksmithInspiration_0</li>
    </incompatibleEvents>
    <randomThingValue>400</randomThingValue>
    <randomThingRewardDef>RERD_Weapons</randomThingRewardDef>
  </FactionColonies.FCEventDef>

  <FactionColonies.FCEventDef>
    <defName>blacksmithInspiration_1-3</defName>
    <label>Blacksmith Inspiration (Workshop Materials)</label>
    <desc>The blacksmith works with materials diverted from your settlement's production lines. The diversion slows weapons output, but the blacksmith's work proceeds well.</desc>
    <category>EC_Economy</category>
    <timeTillTrigger>300000</timeTillTrigger>
    <timeTillTriggerMax>420000</timeTillTriggerMax>
    <rangeSettlementsAffected>1~1</rangeSettlementsAffected>
    <incompatibleEvents>
      <li>blacksmithInspiration_0</li>
    </incompatibleEvents>
    <statModifiers>
      <li>
        <stat>RTD_Weapons_ProductionAdditive</stat>
        <value>-1</value>
      </li>
    </statModifiers>
    <randomThingValue>1000</randomThingValue>
    <randomThingRewardDef>RERD_Weapons</randomThingRewardDef>
  </FactionColonies.FCEventDef>

</Defs>
